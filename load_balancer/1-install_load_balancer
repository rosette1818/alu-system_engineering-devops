#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 to load balance between web-01 and web-02

apt-get update
apt-get -y install haproxy

if ! grep -q "frontend http_front" /etc/haproxy/haproxy.cfg; then
	cat << 'INNER_EOF' >> /etc/haproxy/haproxy.cfg

frontend http_front
	bind *:80
	mode http
	default_backend http_back

backend http_back
	balance roundrobin
	server 7418-web-01 13.40.2.131:80 check
	server 7418-web-02 11.22.33.44:80 check
INNER_EOF
fi

echo "ENABLED=1" >> /etc/default/haproxy
service haproxy restart
